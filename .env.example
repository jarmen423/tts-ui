# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Bring Your Own Keys (optional server fallbacks)
# NOTE: This app enforces STRICT BYOK for paid providers. These env vars are
# IGNORED by the server (they only trigger a startup security warning). Users
# must paste keys into the UI, which sends them per-request.
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""
XAI_API_KEY=""

# FISH_API_KEY(S): the one exception. Fish Audio's free `s2.1-pro-free` model
# has no hard usage cap during the preview window (see
# https://fish.audio/blog/s2-1-pro-free-api/), so the deployer may share keys so
# visitors can synthesize without their own key. Use either a single key or a
# comma/newline-separated list (the server round-robins across the pool).
# Leave blank to enforce strict BYOK for Fish Audio too.
# FISH_API_KEY=""
# FISH_API_KEYS="key1,key2,key3"

# HF_TOKEN is the one exception: optional, used for private Hugging Face Spaces.
HF_TOKEN=""
